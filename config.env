# general
output_name=render.ppm
samples_per_pixel=100
max_depth=50

# diminstions
image_width_pixels=1366
aspect_ratio=1.777_777_777_8
viewport_height=2.0

# Camera
focal_length=1.0
vfov=20

# Camera orientation (each axis optional; vector used only if all 3 present)
lookfrom_x=2
lookfrom_y=2
lookfrom_z=1

lookat_x=0
lookat_y=0
lookat_z=-1

vup_x=0
vup_y=1
vup_z=0

# Field of view and defocus blur
defocus_angle=0.0
focus_dist=3.92